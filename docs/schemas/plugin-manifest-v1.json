{
  "$id": "https://helm-agent.dev/schemas/plugin-manifest-v1.json",
  "type": "object",
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "description",
    "engines",
    "runtime"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "publisher": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "engines": {
      "type": "object",
      "required": [
        "helm",
        "protocol"
      ],
      "additionalProperties": false,
      "properties": {
        "helm": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "node",
            "python",
            "exec"
          ]
        },
        "entry": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "activation": {
      "type": "array",
      "items": {
        "enum": [
          "onTool",
          "onCommand",
          "onSession",
          "onStartup",
          "onProvider"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "optional": {
            "type": "boolean"
          },
          "userExtensible": {
            "type": "boolean"
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "effect",
              "inputSchema"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,40}$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "minLength": 5,
                "maxLength": 1024
              },
              "effect": {
                "enum": [
                  "read",
                  "write",
                  "external",
                  "exec"
                ]
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "approval": {
                "enum": [
                  "auto",
                  "ask"
                ]
              },
              "inputSchema": {
                "type": "object"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 600000
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,40}$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "args": {
                "type": "object"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "watch",
                  "intercept"
                ]
              },
              "priority": {
                "type": "integer"
              },
              "onError": {
                "enum": [
                  "continue",
                  "block"
                ]
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 50,
                "maximum": 30000
              }
            }
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,40}$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,40}$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "defaultModel": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 900000
              }
            }
          }
        },
        "configuration": {
          "type": "object"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900000
        },
        "activationTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 32,
          "maximum": 8192
        },
        "idleTimeoutMs": {
          "type": "integer",
          "minimum": 1000
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Helm plugin manifest (helm-plugin.json), version 1"
}
