{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@helm-agent/plugin-sdk": ["../../packages/sdk-node/src/index.ts"],
      "@helm-agent/plugin-sdk/testing": ["../../packages/sdk-node/src/testing.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
